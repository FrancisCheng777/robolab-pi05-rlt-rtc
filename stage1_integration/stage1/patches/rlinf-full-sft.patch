+class Float32PatchEmbedding(nn.Conv2d):
+    """Keep FP32 convolution inside forward so FSDP can gather the stem weights."""
+
+    def forward(self, x: torch.Tensor) -> torch.Tensor:
+        with torch.autocast(device_type=x.device.type, enabled=False):
+            return F.conv2d(
+                x.float(),
+                self.weight.float(),
+                None if self.bias is None else self.bias.float(),
+                self.stride,
+                self.padding,
+                self.dilation,
+                self.groups,
+            )
